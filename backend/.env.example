# --- Flask ---
FLASK_ENV=production
SECRET_KEY=change-me-to-a-random-64-char-string
JWT_SECRET_KEY=change-me-to-a-different-random-64-char-string
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRES_DAYS=30

# --- Database (PostgreSQL) ---
# postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://grocerygo:password@localhost:5432/grocerygo

# --- Razorpay ---
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxx

# --- UPI ---
UPI_MERCHANT_VPA=freshmart@upi
UPI_MERCHANT_NAME=FreshMart

# --- CORS ---
CORS_ORIGINS=http://localhost:3000,http://localhost:19006

# --- Rate limiting ---
RATE_LIMIT_DEFAULT=200 per hour

# --- File uploads (branding logos etc.) ---
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH_MB=5
